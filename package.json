{
  "name": "birdieflap",
  "version": "1.0.0",
  "description": "A cozy pixel-art Flappy Bird desktop game.",
  "main": "main.js",
  "author": "Birdieflap",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.birdieflap.desktop",
    "productName": "Birdieflap",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "game.js",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
